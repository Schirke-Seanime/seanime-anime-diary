  "website": "https://github.com/Schirke/seanime-anime-diary",
  "lang": "ru",
  "payloadURI": "https://raw.githubusercontent.com/Schirke/seanime-anime-diary/main/src/AnimeDiary.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist",
        "anilist-token",
        "database",
        "storage"
      ]
    }
  }
}
